<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- «Моя стрічка»: аналіз спільнот і рекомендацій, показаний самому користувачеві -->
<ScrollPane fitToWidth="true" styleClass="edge-to-edge"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.social.client.controller.AnalyticsController">
    <VBox spacing="14.0">
        <padding>
            <Insets top="16.0" right="20.0" bottom="20.0" left="20.0" />
        </padding>

        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="Моя стрічка" styleClass="title-label" />
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="refreshButton" text="Оновити" onAction="#handleRefresh"
                    styleClass="button, button-secondary" />
        </HBox>
        <Label text="Що бачить система: ваша спільнота, з чого складається стрічка «Для вас» і що ви вподобуєте порівняно з усією мережею."
               styleClass="secondary-label" wrapText="true" />
        <Label fx:id="statusLabel" styleClass="secondary-label" wrapText="true" />

        <VBox fx:id="sections" spacing="14.0" />
    </VBox>
</ScrollPane>
