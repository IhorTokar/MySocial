<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.social.client.controller.AdminEchoHistoryController">
    <padding>
        <Insets top="16.0" right="4.0" bottom="8.0" left="4.0" />
    </padding>

    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <ComboBox fx:id="algorithmCombo" prefWidth="120.0" />
        <Label fx:id="summaryLabel" styleClass="secondary-label" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="resetScenarioButton" text="Прибрати тестові групи" onAction="#handleResetScenario"
                styleClass="button, link-button" />
        <Button fx:id="scenarioButton" text="Сценарій для звіту" onAction="#handleRunScenario"
                styleClass="button, button-secondary" />
        <Button text="Оновити" onAction="#handleRefresh" styleClass="button, button-secondary" />
        <Button fx:id="snapshotButton" text="Зробити знімок" onAction="#handleSnapshot"
                styleClass="button, button-primary" />
    </HBox>

    <LineChart fx:id="chart" animated="false" legendSide="TOP" minHeight="200.0" prefHeight="260.0">
        <xAxis>
            <CategoryAxis label="Знімок" />
        </xAxis>
        <yAxis>
            <NumberAxis label="Echo-score" forceZeroInRange="false" />
        </yAxis>
    </LineChart>

    <HBox spacing="12.0" VBox.vgrow="ALWAYS">
        <VBox spacing="6.0" HBox.hgrow="ALWAYS" prefWidth="420.0">
            <Label text="Знімки" styleClass="post-title" />
            <TableView fx:id="snapshotTable" VBox.vgrow="ALWAYS" />
        </VBox>
        <VBox spacing="6.0" HBox.hgrow="ALWAYS" prefWidth="520.0">
            <Label fx:id="detailTitle" text="Спільноти знімка" styleClass="post-title" />
            <TableView fx:id="communityTable" VBox.vgrow="ALWAYS" />
        </VBox>
    </HBox>

    <Label fx:id="statusLabel" styleClass="secondary-label" wrapText="true" />
</VBox>