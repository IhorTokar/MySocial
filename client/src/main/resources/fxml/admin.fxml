<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.social.client.controller.AdminPanelController">
    <padding>
        <Insets top="20.0" right="24.0" bottom="16.0" left="24.0" />
    </padding>

    <Label text="Адмін-панель" styleClass="title-label" />

    <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="admin-tabs">
        <Tab fx:id="weightsTab" text="Ваги стрічки">
            <fx:include fx:id="weights" source="admin_weights.fxml" />
        </Tab>
        <Tab fx:id="usersTab" text="Користувачі">
            <fx:include fx:id="users" source="admin_users.fxml" />
        </Tab>
        <Tab fx:id="contentTab" text="Контент">
            <fx:include fx:id="content" source="admin_content.fxml" />
        </Tab>
        <Tab fx:id="graphTab" text="Граф">
            <fx:include fx:id="graph" source="admin_graph.fxml" />
        </Tab>
        <Tab fx:id="echoTab" text="Історія ехо-камер">
            <fx:include fx:id="echoHistory" source="admin_echo_history.fxml" />
        </Tab>
        <Tab fx:id="passwordRequestsTab" text="Заявки на пароль">
            <fx:include fx:id="passwordRequests" source="admin_password_requests.fxml" />
        </Tab>
        <Tab fx:id="auditTab" text="Журнал дій">
            <fx:include fx:id="audit" source="admin_audit.fxml" />
        </Tab>
    </TabPane>
</VBox>