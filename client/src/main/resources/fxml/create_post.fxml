<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      stylesheets="@../css/styles.css"
      fx:controller="com.example.social.client.controller.CreatePostController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>

    <Label fx:id="titleLabel" styleClass="title-label" text="Новий пост" />

    <TextField fx:id="labelField" promptText="Заголовок (необов'язково)" styleClass="text-field" />
    <TextArea fx:id="textArea" prefRowCount="6" promptText="Про що ваш пост?" wrapText="true" styleClass="text-area" />
    <TextField fx:id="tagsField" promptText="#тег1 #тег2 #тег3" styleClass="text-field" />

    <Label fx:id="statusLabel" styleClass="error-label" wrapText="true" />

    <Button fx:id="submitButton" onAction="#handleSubmit" styleClass="button, button-primary" text="Опублікувати" />
    <Button fx:id="cancelButton" onAction="#handleCancel" styleClass="button, button-secondary" text="Скасувати" />
</VBox>