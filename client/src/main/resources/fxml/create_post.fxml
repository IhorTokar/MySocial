<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      styleClass="post-card"
      fx:controller="com.example.social.client.controller.CreatePostController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="16.0" />
    </padding>

    <Label fx:id="titleLabel" styleClass="title-label" text="Новий пост" />

    <TextField fx:id="labelField" promptText="Заголовок (необов'язково)" styleClass="text-field" />
    <TextArea fx:id="textArea" prefRowCount="4" promptText="Про що ваш пост?" wrapText="true" styleClass="text-area" />
    <TextField fx:id="tagsField" promptText="#тег1 #тег2 #тег3" styleClass="text-field" />

    <ImageView fx:id="imagePreview" fitWidth="360.0" preserveRatio="true" visible="false" managed="false" />

    <HBox spacing="10.0">
        <Button fx:id="chooseImageButton" onAction="#handleChooseImage" text="Додати фото"
                styleClass="button, button-secondary" />
        <Button fx:id="removeImageButton" onAction="#handleRemoveImage" text="Прибрати фото"
                styleClass="button, button-secondary" visible="false" managed="false" />
    </HBox>

    <Label fx:id="statusLabel" wrapText="true" />

    <HBox spacing="10.0">
        <Button fx:id="submitButton" onAction="#handleSubmit" styleClass="button, button-primary" text="Опублікувати" />
        <Button fx:id="cancelButton" onAction="#handleCancel" styleClass="button, button-secondary" text="Скасувати" />
    </HBox>
</VBox>