<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.social.client.controller.MainShellController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="app-header">
            <Label styleClass="title-label" text="Соціальна мережа" />
        </HBox>
    </top>

    <left>
        <VBox prefHeight="623.0" spacing="6.0" styleClass="nav-sidebar">
            <Button fx:id="navFeedButton" onAction="#handleShowFeed" styleClass="nav-link" text="🏠  Стрічка" />
            <Button fx:id="navProfileButton" onAction="#handleShowMyProfile" styleClass="nav-link" text="👤  Мій профіль" />
            <Button fx:id="navSavedButton" onAction="#handleShowSaved" styleClass="nav-link" text="🔖  Збережені" />
         <Button mnemonicParsing="false" prefHeight="40.0" prefWidth="144.0" styleClass="nav-link" text="🔖  Повідомлення" textAlignment="RIGHT" />

            <VBox VBox.vgrow="ALWAYS" />

            <Button fx:id="newPostButton" onAction="#handleNewPost" styleClass="button-primary" text="＋  Новий пост">
                <VBox.margin>
                    <Insets bottom="8.0" top="12.0" />
                </VBox.margin>
            </Button>
            <Button fx:id="logoutButton" onAction="#handleLogout" styleClass="button-secondary" text="Вийти" />
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" />
    </center>

</BorderPane>
