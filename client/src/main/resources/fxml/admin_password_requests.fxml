<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.social.client.controller.AdminPasswordRequestsController">
    <padding>
        <Insets top="16.0" right="4.0" bottom="8.0" left="4.0" />
    </padding>

    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <ComboBox fx:id="filterCombo" prefWidth="140.0" />
        <Label fx:id="countLabel" styleClass="secondary-label" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Оновити" onAction="#handleRefresh" styleClass="button, button-secondary" />
    </HBox>

    <TableView fx:id="requestsTable" VBox.vgrow="ALWAYS" />

    <VBox fx:id="detailCard" styleClass="post-card" spacing="8.0" visible="false" managed="false">
        <padding>
            <Insets top="12.0" right="16.0" bottom="12.0" left="16.0" />
        </padding>
        <Label fx:id="detailTitle" styleClass="post-title" />
        <Label fx:id="detailInfo" styleClass="secondary-label" wrapText="true" />
        <Label text="Перш ніж скидати пароль, переконайтеся, що контакт із заявки збігається з даними акаунта (email / телефон). Тимчасовий пароль повідомте користувачу саме за цим контактом."
               styleClass="secondary-label" wrapText="true" />
        <HBox fx:id="actionsBox" spacing="8.0" alignment="CENTER_LEFT">
            <TextField fx:id="passwordField" promptText="Тимчасовий пароль (мін. 8 символів)" prefWidth="260.0"
                       styleClass="text-field" />
            <Button text="Згенерувати" onAction="#handleGenerate" styleClass="button, button-secondary" />
            <Button text="Встановити пароль" onAction="#handleResolve" styleClass="button, button-primary" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Відкрити користувача" onAction="#handleOpenUser" styleClass="button, link-button" />
            <Button text="Відхилити" onAction="#handleReject" styleClass="button, button-danger" />
        </HBox>
        <Label fx:id="statusLabel" wrapText="true" />
    </VBox>
</VBox>