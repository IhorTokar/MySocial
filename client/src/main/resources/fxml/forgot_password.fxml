<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.social.client.controller.ForgotPasswordController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label text="Відновлення доступу" styleClass="title-label" />
    <Label text="Залиште заявку — адміністратор перевірить, що акаунт ваш, встановить тимчасовий пароль і повідомить його за вказаним контактом. Після входу змініть пароль у налаштуваннях."
           styleClass="secondary-label" wrapText="true" maxWidth="340.0" />

    <TextField fx:id="loginField" promptText="Ім'я користувача або email" maxWidth="340.0" styleClass="text-field" />
    <TextField fx:id="contactField" promptText="Як з вами зв'язатися: телефон, email, Telegram"
               maxWidth="340.0" styleClass="text-field" />
    <TextArea fx:id="messageField" promptText="Коментар (необов'язково)" wrapText="true"
              prefRowCount="3" maxWidth="340.0" />

    <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" maxWidth="340.0" />
    <Label fx:id="successLabel" styleClass="success-label" wrapText="true" maxWidth="340.0" />

    <Button fx:id="submitButton" text="Надіслати заявку" defaultButton="true" onAction="#handleSubmit"
            maxWidth="340.0" styleClass="button, button-primary" />
    <Button text="Повернутися до входу" onAction="#handleBack" maxWidth="340.0" styleClass="button, link-button" />
</VBox>