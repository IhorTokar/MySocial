<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.social.client.controller.AdminCommunitiesController">
    <padding>
        <Insets top="16.0" right="4.0" bottom="8.0" left="4.0" />
    </padding>

    <HBox spacing="8.0" alignment="CENTER_LEFT">
        <ComboBox fx:id="algorithmCombo" prefWidth="120.0" />
        <Label fx:id="summaryLabel" styleClass="secondary-label" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="refreshButton" text="Оновити" onAction="#handleRefresh"
                styleClass="button, button-secondary" />
        <Button fx:id="redetectButton" text="Перевизначити спільноти" onAction="#handleRedetect"
                styleClass="button, button-primary" />
    </HBox>

    <Label fx:id="qualityLabel" styleClass="secondary-label" wrapText="true" minHeight="-Infinity" />

    <HBox spacing="12.0" VBox.vgrow="ALWAYS">
        <VBox spacing="6.0" HBox.hgrow="ALWAYS" prefWidth="600.0">
            <Label text="Спільноти" styleClass="post-title" />
            <TableView fx:id="communityTable" VBox.vgrow="NEVER" />
            <Label fx:id="matrixTitle" text="Підписки між спільнотами" styleClass="post-title" />
            <ScrollPane fx:id="matrixScroll" VBox.vgrow="ALWAYS" minHeight="150.0" fitToHeight="false">
                <GridPane fx:id="matrixGrid" hgap="3.0" vgap="3.0">
                    <padding>
                        <Insets top="4.0" right="4.0" bottom="4.0" left="4.0" />
                    </padding>
                </GridPane>
            </ScrollPane>
        </VBox>

        <VBox spacing="6.0" prefWidth="430.0" minWidth="360.0">
            <Label fx:id="detailTitle" text="Спільнота" styleClass="post-title" />
            <Label fx:id="detailInfo" styleClass="secondary-label" wrapText="true" minHeight="-Infinity" />
            <Label text="Лідери — PageRank (1 — середній рівень впливу)" styleClass="secondary-label" />
            <TableView fx:id="leaderTable" />
            <Label text="«Мости» спільноти — коефіцієнт участі P" styleClass="secondary-label" />
            <TableView fx:id="bridgeTable" />
            <Label text="«Мости» всієї мережі" styleClass="post-title" />
            <TableView fx:id="networkBridgeTable" VBox.vgrow="ALWAYS" minHeight="120.0" />
        </VBox>
    </HBox>

    <Label fx:id="statusLabel" styleClass="secondary-label" wrapText="true" />
</VBox>
