<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.social.client.controller.FollowsController">

    <VBox styleClass="app-header" spacing="8.0">
        <Label fx:id="titleLabel" styleClass="title-label" />
        <HBox spacing="8.0">
            <Button fx:id="followingTabButton" text="Підписки" onAction="#handleShowFollowing"
                    styleClass="button, button-primary" />
            <Button fx:id="followersTabButton" text="Підписники" onAction="#handleShowFollowers"
                    styleClass="button, button-secondary" />
        </HBox>
        <Label fx:id="statusLabel" styleClass="secondary-label" />
    </VBox>

    <ListView fx:id="listView" styleClass="list-view" VBox.vgrow="ALWAYS" />

</VBox>