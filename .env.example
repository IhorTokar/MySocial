# Шаблон налаштувань. Скопіюйте цей файл у .env (у корені проєкту) і впишіть свої значення.
# Файл .env не потрапляє в git. Значення пишуться без лапок.

# PostgreSQL (використовують і сервер, і docker-compose)
DB_URL=jdbc:postgresql://localhost:5432/social_network
DB_USERNAME=social_app
DB_PASSWORD=change-me

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

# Ключ підпису JWT-токенів: випадковий рядок, щонайменше 32 символи
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
